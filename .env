BOT_TOKEN=123456:ABCDEF

# Публичный URL сервиса на Northflank, например:
# https://tg-video-link-bot--proj-xyz.northflank.app
BASE_URL=

# Сколько минут живет ссылка /dl/<token>
LINK_TTL_MINUTES=30

# Опционально: разрешить отправку файла в Telegram (скачивание на сервер + sendDocument)
ENABLE_TELEGRAM_UPLOAD=1
MAX_TG_UPLOAD_MB=45

# Ограничение параллельных задач (для 1–3 пользователей хватит 1–2)
MAX_CONCURRENT_TASKS=2

# (Опционально) Cookies для yt-dlp, если понадобится доступ к приватным/возрастным видео:
# YTDLP_COOKIES_B64= (base64 от cookies.txt)
YTDLP_COOKIES_B64=
