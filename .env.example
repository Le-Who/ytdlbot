BOT_TOKEN=
BASE_URL=http://localhost:8000
WEBHOOK_URL=
TELEGRAM_SECRET_TOKEN=
TMPDIR=/tmp/ytdlbot

MAX_TG_UPLOAD_MB=50
MAX_DL_MB=1000
MAX_CONCURRENT_TASKS=2
LIMITER_USER_CAPACITY=5
LIMITER_USER_REFILL_PER_SEC=0.5
LIMITER_CHAT_CAPACITY=20
LIMITER_CHAT_REFILL_PER_SEC=1
LIMITER_IP_CAPACITY=15
LIMITER_IP_REFILL_PER_SEC=1
LIMITER_TOKEN_CAPACITY=3
LIMITER_TOKEN_REFILL_PER_SEC=0.25

MAX_TEMP_AGE_SECONDS=3600
JANITOR_INTERVAL_SECONDS=300

# yt-dlp concurrent fragment downloads for DASH/HLS streams (default: 8)
YTDLP_CONCURRENT_FRAGMENTS=8
# Enable direct piping to Telegram for YouTube (no disk I/O, no progress bar, experimental)
YOUTUBE_PIPE_MODE=0

# Cobalt API Backend (Primary TikTok backend, watermark-free)
# Default is public instance. If you have a private instance, change URL and set API Key.
COBALT_API_URL=https://api.cobalt.tools
COBALT_API_KEY=

# Cookies (base64-encoded Netscape cookies file)
# YTDLP_COOKIES_B64 — global fallback (YouTube, VK, etc.)
# TIKTOK_COOKIES_B64 — override for TikTok (takes priority over global)
# FACEBOOK_COOKIES_B64 — override for Facebook (takes priority over global)
# VK_COOKIES_B64 — override for VK (required for vk.com/audio downloads)
#   How to get: log in to vk.com in Firefox → export with "Get cookies.txt LOCALLY"
#   extension → base64-encode the file → paste here
YTDLP_COOKIES_B64=
TIKTOK_COOKIES_B64=
FACEBOOK_COOKIES_B64=
VK_COOKIES_B64=

# TikTok proxy (SOCKS5/HTTP) for bypassing datacenter IP blocks
# TIKTOK_PROXY=socks5://wireguard-proxy:1080
