BOT_TOKEN=
BASE_URL=http://localhost:8000
WEBHOOK_URL=
TELEGRAM_SECRET_TOKEN=
APP_RELEASE=dev
LOG_ENVIRONMENT=development
LOG_SERVICE=ytdlbot
BOT_IMAGE=
TMPDIR=/tmp/ytdlbot
MEDIA_DIR=/srv/ytdlbot/media
YTDLBOT_JOB_DB=/srv/ytdlbot/state/jobs.sqlite3
TELEGRAM_LOCAL_ENDPOINT=http://tg-api:8081
TELEGRAM_LOCAL_REQUIRED=1

MAX_MEDIA_FILE_MB=2000
TELEGRAM_CLOUD_MAX_FILE_MB=50
MAX_CONCURRENT_TASKS=2
LIMITER_USER_CAPACITY=5
LIMITER_USER_REFILL_PER_SEC=0.5
LIMITER_CHAT_CAPACITY=20
LIMITER_CHAT_REFILL_PER_SEC=1
LIMITER_IP_CAPACITY=15
LIMITER_IP_REFILL_PER_SEC=1
LIMITER_TOKEN_CAPACITY=3
LIMITER_TOKEN_REFILL_PER_SEC=0.25

MAX_TEMP_AGE_SECONDS=3600
JANITOR_INTERVAL_SECONDS=300

# yt-dlp concurrent fragment downloads for DASH/HLS streams (default: 8)
YTDLP_CONCURRENT_FRAGMENTS=8
# Legacy downloader pipe option. The active media pipeline uses bounded disk
# materialization and validation; this flag does not bypass that pipeline.
YOUTUBE_PIPE_MODE=0

# Optional Cobalt origins. The media pipeline enables this provider only after
# its configured endpoint contract has been verified; this is not a YouTube fallback.
COBALT_API_URL=https://api.cobalt.tools
COBALT_API_KEY=
COBALT_CONTRACT_VERIFIED=0
SNAPSAVE_CONTRACT_VERIFIED=0

# Cookies (base64-encoded Netscape cookies file)
# YTDLP_COOKIES_B64 — global fallback (YouTube, VK, etc.)
# Public yt-dlp/gallery-dl provider requests do not use personal cookies.
# TIKTOK_COOKIES_B64 — override for TikTok (takes priority over global)
# FACEBOOK_COOKIES_B64 — override for Facebook (takes priority over global)
# VK_COOKIES_B64 — override for VK (required for vk.com/audio downloads)
#   How to get: log in to vk.com in Firefox → export with "Get cookies.txt LOCALLY"
#   extension → base64-encode the file → paste here
YTDLP_COOKIES_B64=
TIKTOK_COOKIES_B64=
FACEBOOK_COOKIES_B64=
VK_COOKIES_B64=

# TikTok proxy (SOCKS5/HTTP) for bypassing datacenter IP blocks
# TIKTOK_PROXY=socks5://wireguard-proxy:1080
# Public media extraction routes, in primary/backup order. JSON SOCKS5 URL array.
# Keep credentials in the protected deployment environment, never in Git.
# YouTube uses proxies first; other listed local extractors try direct first.
# A selected proxy also carries stream probes and downloads (CDN route affinity).
MEDIA_PROXY_URLS=[]
MEDIA_PROXY_PLATFORMS=youtube,instagram,facebook,tiktok,pinterest,vk,rutube,twitter
