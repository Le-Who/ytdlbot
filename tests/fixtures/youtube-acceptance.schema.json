{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ytdlbot.local/schemas/youtube-acceptance.schema.json",
  "title": "Approved YouTube acceptance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval", "shorts", "videos"],
  "properties": {
    "schema_version": {"const": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at"],
      "properties": {
        "status": {"enum": ["pending", "approved"]},
        "approved_by": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,63}$"
        },
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "shorts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/case"}
    },
    "videos": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "url", "traits"],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^(short|video)-(0[1-9]|1[0-2])$"
        },
        "url": {"type": ["string", "null"], "format": "uri"},
        "traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "vertical",
              "horizontal",
              "short-duration",
              "long-duration",
              "720p",
              "1080p",
              "separate-av",
              "multiple-audio-tracks",
              "recent-publication",
              "over-50-mb"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"approval": {"properties": {"status": {"const": "approved"}}}}},
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "approved_by": {"type": "string", "minLength": 1},
              "approved_at": {"type": "string", "format": "date-time"}
            }
          },
          "shorts": {"items": {"properties": {"url": {"type": "string"}}}},
          "videos": {"items": {"properties": {"url": {"type": "string"}}}}
        }
      }
    }
  ]
}
